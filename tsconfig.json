{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "types": [
      "$app/types",
      "@types/node",
      "@types/wicg-file-system-access",
      "vite-plugin-pwa/info",
      "vite-plugin-pwa/client"
    ],
    "paths": {
      "#lib": [
        "./src/lib"
      ],
      "#lib/*": [
        "./src/lib/*"
      ],
      "$lib": [
        "./src/lib"
      ],
      "$lib/*": [
        "./src/lib/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}