{
  "name": "note-me",
  "private": true,
  "version": "2.9.0-develop.5",
  "type": "module",
  "scripts": {
    "start": "vite dev",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "pwa": "npm run build && npm run preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "type": "npm run check",
    "test": "start-server-and-test dev http://localhost:5173 test:e2e",
    "test:e2e": "cypress run",
    "test:open": "cypress open",
    "semantic-release:dry": "semantic-release --dry-run --no-ci",
    "outdated": "npx npm-check-updates",
    "outdated:minor": "npx npm-check-updates -t minor",
    "update": "npm run outdated -- -u",
    "update:minor": "npm run outdated:minor -- -u"
  },
  "dependencies": {
    "@vite-pwa/assets-generator": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "^1.55.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/adapter-netlify": "^7.0.1",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vite-pwa/sveltekit": "^1.1.0",
    "bits-ui": "^2.19.5",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "idb": "^8.0.4",
    "marked": "^18.1.0",
    "melt": "^0.44.0",
    "semantic-release": "^25.0.9",
    "start-server-and-test": "^3.0.13",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
